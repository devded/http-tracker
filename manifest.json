{
  "author": "Dedar Alam",
  "background": {
    "service_worker": "src/js/httpTrackerServiceWorker.js"
  },
  "description": "Inspect and modify HTTP requests and responses, including headers, cookies, and body. Fork of the original HTTP-TRACKER.",
  "manifest_version": 3,
  "name": "HTTP TRACKER PLUS",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "cookies",
    "debugger",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "version": "3.0.0",
  "action": {
    "default_icon": {
      "16": "src/assets/icon_128px.png",
      "32": "src/assets/icon_128px.png",
      "48": "src/assets/icon_128px.png",
      "128": "src/assets/icon_128px.png"
    },
    "default_title": "HTTP TRACKER PLUS : Inspect and modify HTTP requests and responses (headers, cookies, body)."
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Open HTTP TRACKER PLUS if not opened, or bring to front if already opened"
    }
  },
  "options_ui": {
    "page": "/src/html/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "src/assets/icon_128px.png",
    "32": "src/assets/icon_128px.png",
    "48": "src/assets/icon_128px.png",
    "128": "src/assets/icon_128px.png",
    "320": "src/assets/icon_320px.png"
  }
}